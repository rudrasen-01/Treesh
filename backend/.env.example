# ==============================================================================
# Backend Environment Configuration (Template)
# ==============================================================================

# Server
PORT=3000
NODE_ENV=development

# Database (MongoDB Connection String)
MONGODB_URI=mongodb://localhost:27017/treesh

# Authentication
JWT_SECRET=your-strong-random-jwt-secret
JWT_EXPIRES_IN=7d

# Cloudinary (Media Storage)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# VideoSDK (Live Streaming)
VIDEOSDK_API_KEY=your-videosdk-api-key
VIDEOSDK_SECRET_KEY=your-videosdk-secret-key

# Email Service (Gmail SMTP / App Password)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password

# Razorpay (Payments)
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_CURRENCY=INR

# CORS & Frontend URLs
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://www.treesh.tv,https://treesh.tv,https://admin.treesh.tv
VITE_ADMIN_URL=https://www.treesh.tv/admin

# Rate Limiting & Flags
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=5000
ALLOW_REGISTER_AUTOMATCH=false
